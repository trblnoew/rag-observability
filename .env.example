# Local PostgreSQL
POSTGRES_DB=rag_observability
POSTGRES_USER=rag_app
POSTGRES_PASSWORD=rag_local_password
POSTGRES_PORT=5432

# Spring datasource
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rag_observability
DB_USER=rag_app
DB_PASSWORD=rag_local_password

# AI is deliberately disabled until a key is configured.
SPRING_AI_MODEL_CHAT=none
SPRING_AI_MODEL_EMBEDDING=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_CONNECT_TIMEOUT=3s
RAG_EMBEDDING_READ_TIMEOUT=30s
RAG_RETRIEVAL_TOP_K=5
RAG_RETRIEVAL_MIN_SIMILARITY=0.0
RAG_GENERATION_CONNECT_TIMEOUT=3s
RAG_GENERATION_READ_TIMEOUT=60s
RAG_GENERATION_MAX_OUTPUT_TOKENS=600
RAG_ANSWER_MINIMUM_SIMILARITY=0.5
RAG_SOURCE_EXCERPT_LENGTH=500

# Local tracing
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_TRACES_SAMPLER_PROBABILITY=1.0

# Document chunking
RAG_CHUNK_SIZE_TOKENS=600
RAG_MAX_CHUNKS_PER_DOCUMENT=500

