### 3-4. DB Chunk 내용과 순서 확인
# @name getDbChunksBeforeEmbedding
GET {{baseUrl}}/api/v1/documents/{{dbDocumentId}}/chunks
Accept: application/json

> {%
    client.test("DB Chunk는 연속된 index이고 아직 embedding되지 않았다", function () {
        client.assert(response.status === 200, "예상 HTTP 200, 실제 " + response.status);
        client.assert(response.body.items.length >= 2, "Chunk가 2개보다 적다");
        response.body.items.forEach(function (item, index) {
            client.assert(item.chunkIndex === index, "chunkIndex가 연속적이지 않다: " + item.chunkIndex);
            client.assert(item.tokenCount > 0, "tokenCount가 0 이하이다");
            client.assert(item.embedded === false, "Embedding 전인데 embedded=true이다");
        });
    });
%}

