### 4-7. DB Chunk 공개 응답에는 vector 배열이 없고 embedded=true이다
GET {{baseUrl}}/api/v1/documents/{{dbDocumentId}}/chunks
Accept: application/json

> {%
    client.test("vector는 숨기고 Embedding 메타데이터만 공개한다", function () {
        response.body.items.forEach(function (item) {
            client.assert(item.embedded === true, "embedded=false인 Chunk가 있다");
            client.assert(item.embeddingProvider === "openai", "provider가 openai가 아니다");
            client.assert(item.embeddingModel === "text-embedding-3-small", "model이 예상값과 다르다");
            client.assert(item.embedding === undefined, "실제 vector 배열이 응답에 노출됐다");
        });
    });
%}

### 5. 직접 질문: DB 문서가 Top-1인지 확인 (실제 OpenAI 호출)
# @name searchDirectDbQuestion
POST {{baseUrl}}/api/v1/search
Content-Type: application/json
Accept: application/json

{
  "query": "HikariCP connection timeout이 발생하면 어떤 항목을 확인해야 하나요?",
  "topK": 5,
  "minimumSimilarity": -1.0
}

> {%
    client.test("직접 질문은 DB 문서를 Top-1으로 찾는다", function () {
        client.assert(response.status === 200, "예상 HTTP 200, 실제 " + response.status);
        client.assert(response.body.results.length > 0, "검색 결과가 비어 있다");
        var expectedId = client.global.get("dbDocumentId") || client.variables.file.get("dbDocumentId");
        client.assert(String(response.body.results[0].documentId) === String(expectedId), "Top-1이 DB 문서가 아니다");
    });
    client.test("검색 meta와 결과에는 vector가 없다", function () {
        client.assert(response.body.meta.embeddingProvider === "openai", "meta provider가 openai가 아니다");
        client.assert(response.body.meta.embeddingModel === "text-embedding-3-small", "meta model이 예상값과 다르다");
        client.assert(response.body.meta.dimensions === 1536, "meta dimensions가 1536이 아니다");
        response.body.results.forEach(function (item, index) {
            client.assert(item.embedding === undefined, "검색 결과에 vector가 노출됐다");
            if (index > 0) {
                client.assert(response.body.results[index - 1].similarity >= item.similarity, "similarity 내림차순이 아니다");
            }
        });
    });
%}

### 6. 어려운 표현: DB 문서가 Top-3 안인지 확인 (실제 OpenAI 호출)
# @name searchParaphrasedDbQuestion
POST {{baseUrl}}/api/v1/search
Content-Type: application/json
Accept: application/json

{
  "query": "트래픽이 몰릴 때 애플리케이션이 데이터 저장소와 대화할 통로를 제때 빌리지 못한다면 어떤 자원과 대기 상태를 조사해야 하나요?",
  "topK": 5,
  "minimumSimilarity": -1.0
}

> {%
    client.test("바꿔 말한 질문도 DB 문서를 Top-3 안에서 찾는다", function () {
        client.assert(response.status === 200, "예상 HTTP 200, 실제 " + response.status);
        var expectedId = client.global.get("dbDocumentId") || client.variables.file.get("dbDocumentId");
        var topThree = response.body.results.slice(0, 3);
        var found = topThree.some(function (item) {
            return String(item.documentId) === String(expectedId);
        });
        client.assert(found, "DB 문서가 Top-3에 없다");
    });
%}

