# 이 요청은 실패가 정상이다. 최초 업로드 직후 한 번만 실행한다.
POST {{baseUrl}}/api/v1/documents
Content-Type: multipart/form-data; boundary=RetrievalLabBoundary
Accept: application/problem+json

--RetrievalLabBoundary
Content-Disposition: form-data; name="file"; filename="db-connection-timeout.md"
Content-Type: text/markdown; charset=UTF-8

< ../samples/retrieval-lab/db-connection-timeout.md
--RetrievalLabBoundary--

> {%
    client.test("동일 파일은 409로 거부된다", function () {
        client.assert(response.status === 409, "예상 HTTP 409, 실제 " + response.status);
    });
%}

### 3-1. DB 문서 Chunking
# @name processDbDocument
POST {{baseUrl}}/api/v1/documents/{{dbDocumentId}}/process
Accept: application/json

> {%
    client.test("DB 문서는 READY이고 Chunk가 2개 이상이다", function () {
        client.assert(response.status === 200, "예상 HTTP 200, 실제 " + response.status);
        client.assert(response.body.status === "READY", "status가 READY가 아니다");
        client.assert(response.body.chunkCount >= 2, "DB 문서 Chunk가 2개보다 적다");
    });
%}

