### 7-2. 관련 없는 질문, threshold=-1.0 (실제 OpenAI 호출)
# @name searchUnrelatedMinusOne
POST {{baseUrl}}/api/v1/search
Content-Type: application/json
Accept: application/json

{
  "query": "연차 신청은 누구에게 승인받아야 하나요?",
  "topK": 5,
  "minimumSimilarity": -1.0
}

> {%
    client.test("관련 없는 질문도 낮은 threshold에서는 정상 응답한다", function () {
        client.assert(response.status === 200, "예상 HTTP 200, 실제 " + response.status);
    });
    client.global.set("unrelatedCountMinusOne", response.body.results.length);
%}

### 7-3. 관련 없는 질문, threshold=0.0 (실제 OpenAI 호출)
# @name searchUnrelatedZero
POST {{baseUrl}}/api/v1/search
Content-Type: application/json
Accept: application/json

{
  "query": "연차 신청은 누구에게 승인받아야 하나요?",
  "topK": 5,
  "minimumSimilarity": 0.0
}

> {%
    client.test("threshold 0.0 결과 수는 -1.0보다 늘지 않는다", function () {
        client.assert(response.status === 200, "예상 HTTP 200, 실제 " + response.status);
        client.assert(response.body.results.length <= client.global.get("unrelatedCountMinusOne"), "threshold를 높였는데 결과가 늘었다");
    });
    client.global.set("unrelatedCountZero", response.body.results.length);
%}

### 7-4. 관련 없는 질문, threshold=0.5 (실제 OpenAI 호출)
# @name searchUnrelatedHalf
POST {{baseUrl}}/api/v1/search
Content-Type: application/json
Accept: application/json

{
  "query": "연차 신청은 누구에게 승인받아야 하나요?",
  "topK": 5,
  "minimumSimilarity": 0.5
}

> {%
    client.test("threshold 0.5 결과 수는 0.0보다 늘지 않는다", function () {
        client.assert(response.status === 200, "예상 HTTP 200, 실제 " + response.status);
        client.assert(response.body.results.length <= client.global.get("unrelatedCountZero"), "threshold를 높였는데 결과가 늘었다");
    });
    client.global.set("unrelatedCountHalf", response.body.results.length);
%}

### 7-5. 관련 없는 질문, threshold=0.7 (실제 OpenAI 호출)
# @name searchUnrelatedHigh
POST {{baseUrl}}/api/v1/search
Content-Type: application/json
Accept: application/json

{
  "query": "연차 신청은 누구에게 승인받아야 하나요?",
  "topK": 5,
  "minimumSimilarity": 0.7
}

> {%
    client.test("threshold 0.7 결과 수는 0.5보다 늘지 않는다", function () {
        client.assert(response.status === 200, "예상 HTTP 200, 실제 " + response.status);
        client.assert(response.body.results.length <= client.global.get("unrelatedCountHalf"), "threshold를 높였는데 결과가 늘었다");
    });
%}

### 선택: 처음부터 다시 할 때만 DB 문서 삭제
# 이 요청부터 아래 세 DELETE는 검증 데이터를 지운다. 다음 RAG 단계에서 재사용하려면 실행하지 않는다.
DELETE {{baseUrl}}/api/v1/documents/{{dbDocumentId}}

### 선택: 처음부터 다시 할 때만 CPU 문서 삭제
DELETE {{baseUrl}}/api/v1/documents/{{cpuDocumentId}}

### 선택: 처음부터 다시 할 때만 배포 문서 삭제
DELETE {{baseUrl}}/api/v1/documents/{{deployDocumentId}}
