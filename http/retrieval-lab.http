# Retrieval 역주행 수동 학습용 요청 모음
#
# 실행 원칙
# 1. 위에서 아래로 한 요청씩 ▶ 버튼을 눌러 실행한다. "Run all"은 사용하지 않는다.
# 2. OPENAI_API_KEY는 이 파일에 적지 않는다. 새 키는 Git에서 제외된 .env에만 넣는다.
# 3. 업로드 성공 handler가 문서 ID를 IntelliJ 세션 전역 변수에 자동 저장한다.
# 4. IntelliJ를 재시작하면 전역 변수가 사라진다. 그 경우 문서 목록에서 ID를 확인해 아래 0을 실제 ID로 바꾼다.
# 5. 각 단계의 관찰값은 docs/retrieval-lab-results.md에 기록한다.

@baseUrl = http://localhost:8080
@dbDocumentId = 1
@cpuDocumentId = 2
@deployDocumentId = 3

### 1-1. 애플리케이션과 DB health 확인
# @name health
GET {{baseUrl}}/actuator/health
Accept: application/json

> {%
    client.test("health는 200이다", function () {
        client.assert(response.status === 200, "예상 HTTP 200, 실제 " + response.status);
    });
    client.test("전체 상태는 UP이다", function () {
        client.assert(response.body.status === "UP", "health status가 UP이 아니다");
    });
%}

### 2-1. DB Connection Timeout 문서 업로드
# @name uploadDbDocument
POST {{baseUrl}}/api/v1/documents
Content-Type: multipart/form-data; boundary=RetrievalLabBoundary
Accept: application/json

--RetrievalLabBoundary
Content-Disposition: form-data; name="title"

DB Connection Timeout 대응 Runbook
--RetrievalLabBoundary
Content-Disposition: form-data; name="file"; filename="db-connection-timeout.md"
Content-Type: text/markdown; charset=UTF-8

< ../samples/retrieval-lab/db-connection-timeout.md
--RetrievalLabBoundary--

> {%
    client.test("DB 문서는 201로 생성된다", function () {
        client.assert(response.status === 201, "예상 HTTP 201, 실제 " + response.status);
    });
    client.test("DB 문서는 Chunking 전 상태다", function () {
        client.assert(response.body.status === "PENDING", "status가 PENDING이 아니다");
        client.assert(response.body.embeddingStatus === "NOT_STARTED", "embeddingStatus가 NOT_STARTED가 아니다");
        client.assert(response.body.sourceType === "MARKDOWN", "sourceType이 MARKDOWN이 아니다");
    });
    if (response.status === 201) {
        client.global.set("dbDocumentId", response.body.id);
        client.log("dbDocumentId=" + response.body.id + " 를 현재 IntelliJ 세션에 저장했다.");
    }
%}

